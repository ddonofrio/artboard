# Node agent settings. These are never exposed to the browser.
AGENT_BASE_URL=http://127.0.0.1:1234
# Empty model IDs enable discovery and use the editor model for review.
AGENT_EDITOR_MODEL=
AGENT_REVIEWER_MODEL=
AGENT_API_KEY=
AGENT_VISION=true
AGENT_MAX_REVIEWS=10
# CLI only; the browser uses Number of layers.
AGENT_LAYERS=1
