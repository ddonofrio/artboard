{
  "name": "artboard",
  "version": "0.1.0",
  "private": true,
  "description": "Retro scene drawing tools for AI agents and Adventure.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "exports": {
    ".": {
      "types": "./dist-lib/core/index.d.ts",
      "import": "./dist-lib/index.js"
    },
    "./agents": {
      "types": "./dist-lib/agents/index.d.ts",
      "import": "./dist-lib/agents.js"
    },
    "./node": {
      "types": "./dist-lib/adapters/node/index.d.ts",
      "import": "./dist-lib/node.js"
    }
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.ui.json",
    "lint": "eslint src scripts tests vite.config.ts playwright.config.ts eslint.config.js",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:ui": "playwright test",
    "build": "vite build && vite build --mode library && tsc -p tsconfig.lib.json",
    "preview": "vite preview --host 127.0.0.1",
    "schemas": "tsx scripts/schemas.ts",
    "examples": "tsx scripts/examples.ts",
    "workflow": "tsx scripts/workflow.ts",
    "cli": "tsx scripts/cli.ts",
    "agent": "tsx scripts/agent.ts"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "3.0.62",
    "ai": "7.0.127",
    "ajv": "8.20.0",
    "jpeg-js": "0.4.4",
    "pngjs": "7.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.7.0",
    "@types/pngjs": "6.0.5",
    "eslint": "9.36.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.44.1",
    "vite": "7.3.6"
  }
}
